# Example values only. Copy to .env and replace every secret before running.
NODE_ENV=development
PORT=3000
TZ=America/Lima

# Matches docker-compose.yml (service "db", host port 5433).
DATABASE_URL=postgresql://erp_dev:erp_dev_password@localhost:5433/erp_dev?schema=public

JWT_ACCESS_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Proxies before the app: 1 = Render; 2 = Vercel rewrite + Render.
TRUST_PROXY_HOPS=1

# Uploaded documents (optional). "database" stores them in PostgreSQL (required in production);
# "disk" writes them under UPLOAD_DIR and is meant for development only.
STORAGE_DRIVER=database
UPLOAD_DIR=./uploads

# Read only by the seed (pnpm prisma db seed). The admin is created only while there are no
# users; the settings row only while it is missing. Fictitious values: replace them.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-12-or-more-chars
COMPANY_NAME=Mi Empresa S.A.C.
COMPANY_RUC=20000000001

# docker-compose.yml credentials (optional; defaults shown).
POSTGRES_USER=erp_dev
POSTGRES_PASSWORD=erp_dev_password
POSTGRES_DB=erp_dev
POSTGRES_TEST_USER=erp_test
POSTGRES_TEST_PASSWORD=erp_test_password
POSTGRES_TEST_DB=erp_test
